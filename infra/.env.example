POSTGRES_PASSWORD=смени-меня
# На стенде исходники лежат в ./src (их кладёт infra/deploy.sh). Локально
# строку не задают — compose подставит дефолт `..`.
WIDGET_BUILD_CONTEXT=./src
# Ядро — ДРУГОЙ compose-проект: по имени сервиса НЕ разрезолвится.
# Проверить фактический маршрут ДО деплоя (см. README §«Провижининг ядра»,
# шаг «маршрут контейнер→ядро»), а не полагаться на догадку.
CORE_BASE_URL=http://172.17.0.1:8100/api
# ASCII-плейсхолдер, а НЕ кириллица (девиация от буквы брифа) — этот ключ
# уезжает в исходящий заголовок `Authorization: Bearer <ключ>` к ядру
# (backend/src/core/client.ts:44). Живой смок подтвердил: кириллица здесь —
# не просто «забыли подставить», а падение КАЖДОГО обращения к ядру ещё до
# сети (`new Headers().set(...)` кидает `TypeError: Cannot convert argument
# to a ByteString` — Fetch API требует latin1). Значение ОБЯЗАНО быть
# заменено настоящим ключом из `tenant:create --json` до первого запуска.
CORE_TENANT_KEY=REPLACE-ME-tenant-create-secret-key
CORE_WEBHOOK_SECRET=подставить-из-tenant-webhook-set
# ВАЖНО (secure context): именно localhost, а НЕ IP стенда. Отсюда строится
# app_url, по которому грузится iframe; страница на http://<IP> не является
# secure context, и getUserMedia в ней мёртв даже через ssh -L. Ручной прогон
# голоса ходит на http://localhost:8200/demo.html внутри туннеля.
WIDGET_PUBLIC_ORIGIN=http://localhost:8200
# LiveKit-хост берётся из participant_token.livekit_url ядра — подставить
# фактический, и обязательно и wss://, и https:// (SDK ходит по обоим).
# ДВЕ ДЕВИАЦИИ от буквы брифа, обе воспроизведены живым смоком (docker
# compose up + curl /app/<token>):
# 1) Значение целиком обёрнуто в двойные кавычки. Без них docker compose
#    (env_file-парсер) читает ведущую одинарную кавычку как quoting-
#    конструкцию, обрывает значение на закрывающей кавычке ('self') и молча
#    заводит ВТОРУЮ, мусорную переменную `wss` из хвоста строки —
#    подтверждено `docker compose config --format json`: без внешних кавычек
#    в контейнер уезжал голый `self` без списка хостов LiveKit вообще.
# 2) Плейсхолдер хоста — ASCII (`REPLACE-ME-livekit-host`), а НЕ кириллица.
#    Это значение целиком попадает в ответный HTTP-заголовок
#    `Content-Security-Policy` (backend/src/routes/appPage.ts). Node
#    (`res.setHeader`) требует latin1 в значении заголовка; кириллица валит
#    ЛЮБОЙ запрос `/app/:token` в 500 (`ERR_INVALID_CHAR: Invalid character
#    in header content`) — то есть форма/чат/голос внутри iframe не
#    открываются вообще, а не просто «голос не работает». Подтверждено живым
#    прогоном контейнера. Реальный LiveKit-хост обязателен ДО первого показа
#    страницы кому бы то ни было — заглушку тоже нельзя не заменить.
WIDGET_CSP_CONNECT_SRC="'self' wss://REPLACE-ME-livekit-host https://REPLACE-ME-livekit-host"
# trustProxy НЕ включаем: сервис слушает :8200 напрямую (иначе IP-кап обходится).
TRUST_PROXY=0
IP_HASH_SALT=случайная-соль-стенда
# Капы — фактически капы СОЗДАНИЙ СЕССИЙ ЯДРА (backend/src/dialogs/budget.ts),
# не строк dialogs. Значения подняты фикс-раундом T3 (10/30 → 20/60): продолжение
# нити после silence и эскалация в голос тратят квоту наравне со стартом —
# на прежних 10/30 фрагментация одного разговора душила легитимных
# посетителей. См. backend/src/config.ts (дефолты в коде уже 20/60) и
# .superpowers/sdd/2026-08-13-widget-mvp/progress.md (АДЪЮДИКАЦИЯ P1).
MAX_DIALOGS_PER_VISITOR_PER_DAY=20
MAX_DIALOGS_PER_IP_PER_DAY=60
CORE_MAX_DURATION_S=600
LOG_LEVEL=info
