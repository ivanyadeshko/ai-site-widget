POSTGRES_PASSWORD=смени-меня

# ── образ ─────────────────────────────────────────────────────────────
# Тег образа из GHCR, публикуется release.yml (sha-XXXXXXX или latest).
# На стенде его ведёт infra/deploy/release.sh — руками править не нужно.
# Раньше здесь стоял WIDGET_BUILD_CONTEXT=./src: стенд собирал образ НА
# МЕСТЕ из залитых rsync'ом исходников. От этого отказались — откатываться
# было не на что, и деплоился не тот образ, что проверял CI. Переменная
# намеренно УДАЛЕНА из примера: её присутствие в .env стенда означает, что
# он ещё на старой схеме, и release.sh её вычищает.
IMAGE_TAG=latest
# Владелец пакетов в ghcr.io. Одно значение и для compose, и для preflight —
# иначе при переезде репозитория в организацию publish идёт под новым
# владельцем, preflight проверяет нового, а pull тянет старого.
IMAGE_OWNER=ivanyadeshko

# ── сетевой режим: как BFF добирается до ядра ─────────────────────────
# Режимов два, и выбирает их ОДНА строка — COMPOSE_FILE. Ошибка здесь не
# косметическая: в режиме `public` без сети ядра стенд рядом с ядром теряет
# маршрут до control-plane и КАЖДЫЙ диалог падает в core_unreachable.
#
# ── (A) attached — стенд стоит РЯДОМ с ядром на одном хосте (дев) ──
# Ядро биндит control-plane на 127.0.0.1:8100 (loopback) — снаружи docker-
# моста недостижимо, поэтому BFF входит во внешнюю сеть ядра override-файлом
# и ходит по внутреннему DNS. Обе строки обязательны вместе:
#   COMPOSE_FILE=compose.yaml:compose.core-network.yaml
#   CORE_BASE_URL=http://control-plane:8000/api
# ⚠️ Порядок при ПЕРВОМ включении: сначала compose.core-network.yaml на хост
#    (его кладёт шаг «Sync deploy assets» деплоя, до первого прогона — руками
#    через scp), и только потом строка COMPOSE_FILE в .env. Наоборот compose
#    падает «no such file» на каждой команде, включая preflight.
#
# ── (B) public — прод витрины, ядра на хосте нет ──
# COMPOSE_FILE не задаётся вовсе (или равен compose.yaml), сеть ядра не
# нужна, BFF ходит в ядро по HTTPS через интернет:
#   CORE_BASE_URL=https://api.ai-speak.ru/api
#   TRUST_PROXY=1          # обязательно: BFF стоит за nginx (см. ниже)
#
# Имя ВНЕШНЕЙ docker-сети ядра — читается только в режиме (A).
# На дев-стенде — conversation-core_default.
CORE_NETWORK=conversation-core_default
COMPOSE_FILE=compose.yaml:compose.core-network.yaml
# Адрес ядра. В режиме (A) BFF находится в ОДНОЙ сети с ядром, поэтому имя
# сервиса `control-plane` резолвится штатным docker-DNS — несмотря на то, что
# ядро живёт в другом compose-проекте. В режиме (B) сюда идёт публичный
# https-адрес ядра. Промежуточный вариант «через host-gateway»
# (http://172.17.0.1:8100/api) работал до появления override и остаётся
# запасным — если он уже стоит в .env живого стенда и стенд работает,
# COMPOSE_FILE ему не нужен вовсе. Фактический маршрут проверять ДО деплоя
# (README §«Маршрут контейнер виджета → ядро»), а не полагаться на догадку.
CORE_BASE_URL=http://control-plane:8000/api
# ASCII-плейсхолдер, а НЕ кириллица (девиация от буквы брифа) — этот ключ
# уезжает в исходящий заголовок `Authorization: Bearer <ключ>` к ядру
# (backend/src/core/client.ts:44). Живой смок подтвердил: кириллица здесь —
# не просто «забыли подставить», а падение КАЖДОГО обращения к ядру ещё до
# сети (`new Headers().set(...)` кидает `TypeError: Cannot convert argument
# to a ByteString` — Fetch API требует latin1). Значение ОБЯЗАНО быть
# заменено настоящим ключом из `tenant:create --json` до первого запуска.
CORE_TENANT_KEY=REPLACE-ME-tenant-create-secret-key
CORE_WEBHOOK_SECRET=подставить-из-tenant-webhook-set
# ВАЖНО (secure context): именно localhost, а НЕ IP стенда. Отсюда строится
# app_url, по которому грузится iframe; страница на http://<IP> не является
# secure context, и getUserMedia в ней мёртв даже через ssh -L. Ручной прогон
# голоса ходит на http://localhost:8200/demo.html внутри туннеля.
WIDGET_PUBLIC_ORIGIN=http://localhost:8200
# LiveKit-хост берётся из participant_token.livekit_url ядра — подставить
# фактический, и обязательно и wss://, и https:// (SDK ходит по обоим).
# ДВЕ ДЕВИАЦИИ от буквы брифа, обе воспроизведены живым смоком (docker
# compose up + curl /app/<token>):
# 1) Значение целиком обёрнуто в двойные кавычки. Без них docker compose
#    (env_file-парсер) читает ведущую одинарную кавычку как quoting-
#    конструкцию, обрывает значение на закрывающей кавычке ('self') и молча
#    заводит ВТОРУЮ, мусорную переменную `wss` из хвоста строки —
#    подтверждено `docker compose config --format json`: без внешних кавычек
#    в контейнер уезжал голый `self` без списка хостов LiveKit вообще.
# 2) Плейсхолдер хоста — ASCII (`REPLACE-ME-livekit-host`), а НЕ кириллица.
#    Это значение целиком попадает в ответный HTTP-заголовок
#    `Content-Security-Policy` (backend/src/routes/appPage.ts). Node
#    (`res.setHeader`) требует latin1 в значении заголовка; кириллица валит
#    ЛЮБОЙ запрос `/app/:token` в 500 (`ERR_INVALID_CHAR: Invalid character
#    in header content`) — то есть форма/чат/голос внутри iframe не
#    открываются вообще, а не просто «голос не работает». Подтверждено живым
#    прогоном контейнера. Реальный LiveKit-хост обязателен ДО первого показа
#    страницы кому бы то ни было — заглушку тоже нельзя не заменить.
WIDGET_CSP_CONNECT_SRC="'self' wss://REPLACE-ME-livekit-host https://REPLACE-ME-livekit-host"
# На ДЕВЕ trustProxy НЕ включаем: сервис слушает :8200 напрямую, и доверие к
# X-Forwarded-For позволило бы обойти IP-кап одним заголовком.
# На ПРОДЕ (за nginx, https-origin) — РОВНО НАОБОРОТ: без TRUST_PROXY=1 req.ip
# равен адресу прокси для ВСЕХ посетителей, суточный IP-кап схлопывает их в
# один бакет и начинает валить живых людей 429. Поэтому preflight
# (infra/deploy/release.sh) делает связку «https-origin + TRUST_PROXY≠1»
# стоп-условием деплоя, а не предупреждением.
TRUST_PROXY=0
IP_HASH_SALT=случайная-соль-стенда
# Капы — фактически капы СОЗДАНИЙ СЕССИЙ ЯДРА (backend/src/dialogs/budget.ts),
# не строк dialogs. Значения подняты фикс-раундом T3 (10/30 → 20/60): продолжение
# нити после silence и эскалация в голос тратят квоту наравне со стартом —
# на прежних 10/30 фрагментация одного разговора душила легитимных
# посетителей. См. backend/src/config.ts (дефолты в коде уже 20/60) и
# .superpowers/sdd/2026-08-13-widget-mvp/progress.md (АДЪЮДИКАЦИЯ P1).
MAX_DIALOGS_PER_VISITOR_PER_DAY=20
MAX_DIALOGS_PER_IP_PER_DAY=60
# Третий ключ капа — ВЛАДЕЛЕЦ САЙТА (аккаунт витрины). Действует, пока админ
# не задал аккаунту свой лимит (таблица account_limits). Предохранитель от
# выжигания баланса ОБЩЕГО тенанта ядра одним клиентом, а не тариф.
#MAX_SESSIONS_PER_ACCOUNT_PER_DAY=300
CORE_MAX_DURATION_S=600
LOG_LEVEL=info

# ── панель владельца сайта (/panel + /api/v1) ─────────────────────────
# Все переменные ниже НЕобязательные: у каждой есть дефолт в
# backend/src/config.ts, и существующий стенд поднимается без них.
#
# Origin, с которого ходит SPA панели. По умолчанию = WIDGET_PUBLIC_ORIGIN
# (панель и API живут на одном хосте, app.vell.pro). Он же — ЕДИНСТВЕННЫЙ
# допустимый Origin на любом не-GET запросе к /api/v1/* (CSRF-барьер D-5),
# поэтому значение обязано совпадать с адресом, по которому владелец реально
# открывает панель в браузере, вплоть до схемы и порта.
# ASCII, без кириллицы (Constraint 11) — значение сравнивается с заголовком.
#WIDGET_PANEL_ORIGIN=http://localhost:8200
# Срок жизни cookie-сессии панели, суток (скользящее окно).
#SESSION_TTL_DAYS=30
# Флаг Secure у cookie. На https-происхождении включается САМ; ставить 1
# нужно там, где TLS терминируется выше и панель считает себя http.
# На чистом http-стенде включать НЕЛЬЗЯ: браузер такую куку не вернёт.
#SESSION_COOKIE_SECURE=0
# Порог неудачных входов ПО ОДНОМУ email и длина окна блокировки, минут.
# Счёт идёт по email, а не по IP: перебор одного аккаунта ведут с меняющихся
# адресов, и IP-лимит его не видит.
#LOGIN_MAX_FAILURES=10
#LOGIN_LOCK_MINUTES=15
# Origin, с которого раздаётся /w.js. По умолчанию = WIDGET_PUBLIC_ORIGIN, и
# тогда embed-сниппет однодоменный. Задавать нужно ТОЛЬКО на раскладке, где
# статика уехала на отдельный домен (cdn.vell.pro): тогда в сниппет
# автоматически добавляется data-host=<WIDGET_PUBLIC_ORIGIN>/ — без него шим
# вычислит базу из своего же src и будет бить /w/v1/... в CDN-хост, где API нет.
# ASCII, без кириллицы (Constraint 11).
#WIDGET_CDN_ORIGIN=https://cdn.vell.pro

# ── лендинг vell.pro (compose-профиль `site`) ─────────────────────────
# Профили compose: пусто = лендинг НЕ поднимается (стенду с одним BFF он не
# нужен). Включить на хосте, где живёт апекс: COMPOSE_PROFILES=site.
COMPOSE_PROFILES=
# Пароль БД лендинга (site-db). ОТДЕЛЬНАЯ база от site_widget: контент CMS и
# продуктовые данные не смешиваем — у них разные бэкапы и разные права.
SITE_DB_PASSWORD=смени-меня
# Секрет подписи сессий Payload. Дефолта в коде НЕТ (payload.config.ts) —
# пусто означает «CMS не стартует». Сгенерировать: openssl rand -hex 32
PAYLOAD_SECRET=REPLACE-ME-openssl-rand-hex-32
# Публичный адрес лендинга и адрес кабинета. ОБА инлайнятся в бандл на этапе
# сборки образа (build-arg), а не читаются в рантайме: правка значения в .env
# без пересборки образа НИЧЕГО не изменит на страницах. БЕЗ слэша на конце.
# Пустые значения валят сборку site/Dockerfile намеренно (fail-fast).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:8200
# Сид-роут POST /api/seed деструктивен (пересоздаёт домашнюю и globals):
# по умолчанию 404. Включать ВРЕМЕННО на первичный засев, потом убирать.
ENABLE_SEED_ROUTES=
# Адрес health лендинга для пост-деплой проверки (infra/deploy/release.sh).
# Дефолт — http://127.0.0.1:3000/api/health. ИМЕННО 127.0.0.1: контейнер
# слушает только IPv4, а `localhost` на хосте может резолвиться в ::1.
#SITE_HEALTH_URL=http://127.0.0.1:3000/api/health
