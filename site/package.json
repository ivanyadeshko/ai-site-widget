{
  "name": "vell-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "build:payload-config": "node -e \"require('esbuild').buildSync({entryPoints:['payload.config.ts'],outfile:'payload.config.mjs',bundle:true,format:'esm',platform:'node',target:'node22',packages:'external',logLevel:'info'})\"",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "payload": "PAYLOAD_CONFIG_PATH=payload.config.mjs payload",
    "migrate": "npm run payload migrate -- --force-accept-warning",
    "migrate:create": "npm run payload migrate:create -- --skip-empty --force-accept-warning"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.83.0",
    "@payloadcms/next": "^3.83.0",
    "@payloadcms/richtext-lexical": "^3.83.0",
    "@payloadcms/ui": "^3.83.0",
    "graphql": "^16.13.2",
    "next": "16.2.4",
    "payload": "^3.83.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "typescript": "^5"
  }
}
