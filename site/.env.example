# ── site/ (лендинг vell.pro: Payload CMS 3 + Next.js) ────────────────
# Локальная разработка: cp .env.example .env, поднять Postgres, npm run dev.
# На стенде эти же переменные приходят из infra/.env (compose-профиль `site`).
#
# ⚠️ Репозиторий ПУБЛИЧНЫЙ: здесь только плейсхолдеры, живых секретов быть
# не должно ни в одном коммите.

# Строка подключения к БД лендинга. Это ОТДЕЛЬНАЯ база от БД виджета
# (site_widget): контент CMS и данные продукта не смешиваем — у них разный
# жизненный цикл, разные бэкапы и разные права.
DATABASE_URI=postgres://site:смени-меня@localhost:55445/vell_site

# Секрет подписи сессий/токенов Payload. Дефолта в коде НЕТ (в отличие от
# apps/cms монолита) — пусто означает «Payload не стартует», и это намеренно.
# Сгенерировать: openssl rand -hex 32
PAYLOAD_SECRET=REPLACE-ME-openssl-rand-hex-32

# Публичный адрес самого лендинга. Инлайнится в бандл на этапе next build
# (build-arg в Dockerfile), используется в canonical/og/sitemap и в списке
# разрешённых origin'ов Payload (cors/csrf).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Адрес кабинета (BFF витрины). Все CTA лендинга ведут на
# $NEXT_PUBLIC_APP_URL/panel/register и /panel/login. БЕЗ слэша на конце.
# Сборка образа падает, если arg пуст (site/Dockerfile) — битая кнопка на
# лендинге должна ловиться в CI, а не пользователем.
NEXT_PUBLIC_APP_URL=http://localhost:8200

# Сид-роут POST /api/seed ДЕСТРУКТИВЕН (пересоздаёт домашнюю страницу и
# globals). По умолчанию выключен → 404. Включать временно на первичный
# засев стенда: ENABLE_SEED_ROUTES=1. Дополнительно требует
# `x-seed-secret: $PAYLOAD_SECRET`.
ENABLE_SEED_ROUTES=
